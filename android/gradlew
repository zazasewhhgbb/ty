##############################################################################
#
#   Gradle start up script for POSIX generated by Gradle.
#
#   This file is a standard Gradle wrapper launcher. If gradle/wrapper/gradle-wrapper.jar
#   is missing (it is not checked into this repo — see README "Android Setup"),
#   run `gradle wrapper` once with any local Gradle install, or simply open
#   this project in Android Studio, which regenerates it automatically on sync.
#
##############################################################################

# Attempt to set APP_HOME
APP_HOME=$( cd "$( dirname "$0" )" && pwd )

APP_NAME="Gradle"
APP_BASE_NAME=${0##*/}

DEFAULT_JVM_OPTS='"-Xmx64m" "-Xms64m"'

warn () {
    echo "$*"
}

die () {
    echo
    echo "$*"
    echo
    exit 1
}

CLASSPATH=$APP_HOME/gradle/wrapper/gradle-wrapper.jar

if [ ! -f "$CLASSPATH" ]; then
    die "ERROR: gradle/wrapper/gradle-wrapper.jar not found.
Open this project in Android Studio (it will regenerate the wrapper jar automatically),
or run 'gradle wrapper' once using a local Gradle installation."
fi

JAVACMD="java"
if ! command -v java >/dev/null 2>&1; then
    die "ERROR: JAVA_HOME is not set and no 'java' command could be found on your PATH."
fi

exec "$JAVACMD" $DEFAULT_JVM_OPTS $JAVA_OPTS $GRADLE_OPTS \
    "-Dorg.gradle.appname=$APP_BASE_NAME" \
    -classpath "$CLASSPATH" \
    org.gradle.wrapper.GradleWrapperMain \
    "$@"
