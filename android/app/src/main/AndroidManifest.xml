<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Needed to reach the self-hosted backend -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Needed for "Record Voice" -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Needed to import large text files -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <application
        android:name=".VoiceGenApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.VoiceGenerator"
        android:usesCleartextTraffic="true"
        tools:targetApi="34">
        <!--
          usesCleartextTraffic is enabled only to make http://<local-ip>:8000
          reachable during local development (spec section 30). Production
          backends should be https:// — see network_security_config.xml,
          which restricts cleartext to private/dev hosts only.
        -->
        <meta-data
            android:name="android.security.net.config"
            android:resource="@xml/network_security_config" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.VoiceGenerator">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Needed so [Share] on a generated audio file works without exposing raw file:// paths -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
